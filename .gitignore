# Python artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Secrets — never commit
.env
.env.*
!.env.example

# Data
data/raw/
data/cache/
# Regenerable build artifacts; each one's sha256 is pinned in its committed summary
data/reactome_membership.tsv
data/pathways.tsv
# The ontology build is a deterministic function of the committed descriptions table and the
# pinned encoder, so it follows the same rule; ontology_summary.tsv pins each artifact's sha256.
data/ontology/*
!data/ontology/ontology_summary.tsv
!data/ontology/baseline_comparison.tsv

# OS
.DS_Store

data/ontology/embeddings.npy
data/ontology/embedding_keys.txt
data/ontology/tree_*.txt
