# Python artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Secrets — never commit
.env
.env.*
!.env.example

# Data
data/raw/
data/cache/
# The naming ledger: content-addressed API responses, regenerable and unbounded.
data/llm_cache/
# Cached scramble sides: regenerable, keyed on space + universe digest + seed.
data/experiments/scramble_sides/
# Regenerable build artifacts; each one's sha256 is pinned in its committed summary
data/reactome_membership.tsv
data/pathways.tsv
# The ontology build is a deterministic function of the committed descriptions table and the
# pinned encoder, so it follows the same rule; ontology_summary.tsv pins each artifact's sha256.
data/ontology/*
!data/ontology/ontology_summary.tsv
!data/ontology/baseline_comparison.tsv
!data/ontology/baseline_cutfree.tsv
!data/ontology/containment.tsv
!data/ontology/encoder_stability.tsv
# Versioned builds are committed (addendum-2026-09-18 A2). Git cannot re-include a file whose
# parent directory is excluded, so the directories are un-ignored before the files.
!data/ontology/v*/
!data/ontology/v*/*/
!data/ontology/v*/*/*.tsv
!data/ontology/v*/*/*.json
# ...except the regenerable matrices, which stay out at ~5.7 MB each.
data/ontology/v*/*.npy
# Key lists are as derived as the vectors they index, including the dated copies kept
# beside a superseded build. v*/universe.json is the committed record of what changed.
data/ontology/v*/embedding_keys*.txt
!data/ontology/clusters_ward.tsv
!data/ontology/clusters_average.tsv
!data/ontology/clusters_complete.tsv

# OS
.DS_Store

# Exploratory cutoff/floor sweeps and seed twins. Scratch, and regenerable from the build
# script; only a FROZEN build is kept. These come AFTER the negation above, which re-includes
# data/ontology/v*/*/*.tsv -- .gitignore is order-sensitive and the last matching rule wins.
data/ontology/v*/recurrent_dag_incl*/
data/ontology/v*/recurrent_dag_cal*/
data/ontology/v*/*_seed1/
# Persisted subsamples for the RUNS ladder: 26 MB, regenerable from seed 20260925.
data/ontology/v*/subsamples/
# Persisted Ward trees and per-run completions for the 10,770: 1,900 .npz files, 0.55 GB, a
# deterministic function of the committed universe and the recorded seeds. The pattern names the
# .npz rather than the directory, because an ignored DIRECTORY cannot have files re-included from
# it -- and the .json files beside the trees (build_log, ladder, floors) are the record of what was
# run and are committed.
data/ontology/v*/trees/**/*.npz
# Ladder blocks: intermediate full builds, one per disjoint block of trees, regenerable from the
# persisted trees and the recorded floors. Only the confirmatory build and the ladder's own result
# table are kept. Comes after the v*/*/*.tsv negation above, which would otherwise re-include them.
data/ontology/v*/recurrent_dag_10770_r*/

# Engine-search completion caches, 6 Oct. Same rule as the Ward caches above: a side is a
# deterministic function of the persisted trees, the engine and the recorded ladder, and its
# provenance mark records which code wrote it. 598 MB for leiden, 431 MB for pooled.
#
# The CONTENTS are ignored, not the directory. Git cannot re-include a file whose parent directory
# is excluded, so ignoring `cap*_leiden/` would make the `!floors_*.json` line below dead and the
# floors record uncommittable. Ignoring `cap*_leiden/*` leaves the directory itself visible, which
# is what lets one file be re-included out of it.
#
# A solved floor is a calibration record, not a cache, and the ones beside the trees are already
# treated that way.
data/ontology/v*/trees/**/completions/cap*_leiden/*
!data/ontology/v*/trees/**/completions/cap*_leiden/floors_*.json
data/ontology/v*/trees/**/completions/cap*_leiden_persistent/*
!data/ontology/v*/trees/**/completions/cap*_leiden_persistent/floors_*.json
data/ontology/v*/trees/**/completions/cap*_pooled/*
!data/ontology/v*/trees/**/completions/cap*_pooled/floors_*.json
data/ontology/v*/trees/**/completions/cap*_bisect/*
!data/ontology/v*/trees/**/completions/cap*_bisect/floors_*.json
data/ontology/v*/trees/**/completions/cap*_infomap/*
!data/ontology/v*/trees/**/completions/cap*_infomap/floors_*.json

# Verification builds that are byte-identical to a build already committed.
# regression_adapter_10770 matches recurrent_dag_10770 on all four TSVs by sha256, so keeping it
# would commit a second copy of the same build.
data/ontology/v*/regression_adapter_10770/

# Side caches preserved rather than deleted: superseded by a setup change, or with no provenance
# mark so their origin could not be established. Kept on disk as the record that they existed and
# what replaced them; not committed, because they are caches either way.
data/ontology/v*/trees/**/completions/**/superseded_range_*/
data/ontology/v*/trees/**/completions/**/no_provenance_mark/

# Test R score arrays, 7 Oct. Per-grouping gap scores and the transfer universes, regenerable from
# the persisted trees plus the recorded subsample seed. The heights beside the trees are already
# covered by the .npz rule above; this covers the score and transfer outputs.
data/ontology/v*/transfer/

# Naive K candidate arrays, 7 Oct. Every mutual-rank candidate with its support and lifetime,
# regenerable in under nine seconds from the committed universe and the recorded run seeds.
data/ontology/v*/naive_k/
data/ontology/v*/naive_k_v2/

# KC theme arrays, 7 Oct. Regenerable in under three seconds from the committed universe; the .json
# summaries beside them are the record and are small, so they are re-included.
data/ontology/v*/kc/*.npz

# HiDeF parameter-grid builds, 7 Oct. A report-only 4x5 sweep, 97 MB across 16 directories, fully
# regenerable from the committed builder in about 40 minutes. The grid summary with every
# recall/precision cell is committed as data/experiments/hidef_grid_2026-10-07.json instead.
data/ontology/v*/hidef_grid_k*/

# v0.4 ablation side material, 7 Oct. 358 MB of completed-family bitsets, one set per ablation,
# regenerable from the persisted trees in about 5-20 minutes a side. The floors.json and
# stages.json beside them are the record every reported number is read from, and are kept.
data/ontology/v*/ablate/**/*.npz
data/ontology/v*/ablate/superseded_*/

# v0.4 ablation build member rosters, 8 Oct. The seven ablations and their fourteen stability
# halves come to 181 MB of members.tsv alone; nodes/edges/unplaced/manifest for all 21 are 10 MB
# and are kept, so every build's shape and provenance stays auditable in the repo. Same rule the
# HiDeF grid got above: the rosters are regenerable from the persisted trees, and every number
# reported from them is committed as data/experiments/v04/ablation_table_tuning.json.
# The rule is scoped to ablate_* so the final v0.4 build keeps its members.tsv.
data/ontology/v*/ablate_*/members.tsv

# The direction pilot's unblinding key: it maps the blinded pilot ids (P0186) back to real pathway
# identities. Committing it would destroy the blinding for anyone who re-runs the pilot, and the
# file name is an explicit instruction. Kept local, never in version control.
data/experiments/direction_pilot/KEY_DO_NOT_SHARE.tsv

# v0.4 cached side material, 8 Oct. 73 MB of matched-and-completed family bitsets plus their
# inclusion votes, for the real side with and without the stages restored. Regenerable in about
# 300 s each from the persisted trees. floors.json beside them is the calibration record -- the
# solved floors and the single held-out confirmation -- and is kept.
data/ontology/v*/calibration/*.npz

# v0.4 stability halves and the matched-count cut: intermediate, built for one statistic each
# (between-half stability, and the equal-theme-count comparison row). Same rule the ablation
# builds got above -- nodes/edges/unplaced/manifest are kept so the shape stays auditable, the
# member rosters are regenerable in 150 s and 90 s. The current core's own roster,
# data/ontology/v0.4/thema_10770/members.tsv, is NOT ignored.
data/ontology/v*/thema_10770_r*/members.tsv
data/ontology/v*/thema_10770_matched*/members.tsv
data/ontology/v*/thema_10770_all_stages_on*/
